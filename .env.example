NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/internet_collector
FRONTEND_URL=http://localhost:5173

# Optional. Keep backend-only and grant the smallest suitable GitHub scope.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28

REQUEST_TIMEOUT_MS=10000
MAX_SEARCH_RESULTS=50
SEARCH_CONCURRENCY=3

# Reserved for later queue and AI adapters.
REDIS_URL=
AI_PROVIDER=none
AI_API_KEY=
